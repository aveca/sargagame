    { "pattern": "sargazotulum.com/collect.php", "zone_name": "sargazotulum.com" },

    // SECURITY 2026-08-28: exact routes for remaining PHP files not covered by existing
    // `api/mollie*`/`api/b2b-*`/`api/track-*` patterns. These files exist in `dist/api/`
    // (27 php) and would otherwise be served as static source on Pages (200 `application/x-httpd-php`).
    // With exact routes they are intercepted AVANT Pages and fall through to generic
    // `path.endsWith('.php') → 404 nosniff` in Worker (no source leak, no secret).
    // `*.php` wildcard invalide (10022) → exact routes only (7 files ×6 zones =42, <100/zone).
    { "pattern": "sargasses-martinique.com/api/_diag.php", "zone_name": "sargasses-martinique.com" },
    { "pattern": "sargasses-martinique.com/api/_ratelimit.php", "zone_name": "sargasses-martinique.com" },
