{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"sargagame-__REGION__",
  "main":"workers/sargagame/index.js",
  "compatibility_date":"2026-10-02",
  "workers_dev":true,
  "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"404-page",
    // SÉCURITÉ : sans run_worker_first, les assets existants contournent le
    // handler (garde _private/.php/dotfiles morte — constaté : /api/.htaccess
    // lisible sur workers.dev). true = chaque requête passe par index.js.
    "run_worker_first":true},
  "vars":{"SUPABASE_URL":"https://rswdmjtdzrucqzzukfmd.supabase.co"},
  "routes":[{"pattern":"__DOMAIN__/*","zone_name":"__DOMAIN__"}]
}