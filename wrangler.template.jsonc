{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"sargagame-__REGION__",
  "main":"workers/sargagame/index.js",
  "compatibility_date":"2026-10-02",
  "workers_dev":true,
  // __ASSETS_DIR__ = dossier préparé par prepare-ftp (ex: ./guadeloupe-ftp).
  // NE JAMAIS remettre "./dist" : dist/ est le build brut MQ/GP, il ne passe
  // par aucun retraitement domaine (canonicals, robots, sitemap.xml, overlay
  // _gp/, swap des données Copernicus) — c'est la régression de prod du 07/10.
  "assets":{"directory":"./__ASSETS_DIR__","binding":"ASSETS","not_found_handling":"404-page",
    // SÉCURITÉ : sans run_worker_first, les assets existants contournent le
    // handler (garde _private/.php/dotfiles morte — constaté : /api/.htaccess
    // lisible sur workers.dev). true = chaque requête passe par index.js.
    "run_worker_first":true},
  "vars":{"SUPABASE_URL":"https://rswdmjtdzrucqzzukfmd.supabase.co"}
  // routes retirés : nécessitent permission "Workers Routes:Edit" sur le token Cloudflare.
  // Le Worker déploie sur workers.dev ; les routes domaines custom se configurent
  // une fois manuellement dans Cloudflare Dashboard (DNS + Workers Routes).
}