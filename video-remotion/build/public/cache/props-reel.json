{"scenes":[{"id":"s1_tf1","type":"card","durF":153,"voice":"cache/vo-reel-s1_tf1.mp3","img":null,"dark":false,"glyph":false,"overlay":null,"card":{"overline":"HIER · LE 13H DE TF1","title":"SARGASSES :\nRECORDS EN\nGUADELOUPE","sub":"Le fléau prend des proportions énormes."}},{"id":"s2_touriste","type":"card","durF":186,"voice":"cache/vo-reel-s2_touriste.mp3","img":null,"dark":false,"glyph":false,"overlay":null,"card":{"overline":"UNE TOURISTE, AU 13H","title":"« Je regarde\nchaque jour quelle\nplage est chargée. »","sub":"Elle planifie ses vacances à l'aveugle."}},{"id":"s3_veilleur","type":"card","durF":165,"voice":"cache/vo-reel-s3_veilleur.mp3","img":null,"dark":false,"glyph":true,"overlay":null,"card":{"overline":"LA SEULE DIFFÉRENCE","title":"Elle devine.\nNous, on mesure.","sub":"Au satellite."}},{"id":"s4_pelle","type":"photo","durF":250,"voice":"cache/vo-reel-s4_pelle.mp3","img":"cache/img-reel-s4_pelle.jpg","dark":true,"glyph":false,"overlay":{"overline":"RAMASSER À LA PELLE","title":"On emporte\nle sable avec.","pill":"« On détruit ces plages »","pillColor":"#E8522A","sub":"Le ramasseur, au 13h de TF1"},"card":null},{"id":"s5_veilleur2","type":"card","durF":168,"voice":"cache/vo-reel-s5_veilleur2.mp3","img":null,"dark":false,"glyph":true,"overlay":null,"card":{"overline":"LE VEILLEUR","title":"Il ne touche\npas la plage.","sub":"Il regarde la mer."}},{"id":"s6_verdict","type":"photo","durF":186,"voice":"cache/vo-reel-s6_verdict.mp3","img":"cache/img-reel-s6_verdict.jpg","dark":false,"glyph":false,"overlay":{"overline":"CHAQUE MATIN · PLAGE PAR PLAGE","title":"PROPRE\nOU PAS.","pill":"AUJOURD'HUI + 7 JOURS","pillColor":"#22C55E","sub":"Deshaies, côte sous le vent"},"card":null},{"id":"s7_fiabilite","type":"card","durF":249,"voice":"cache/vo-reel-s7_fiabilite.mp3","img":null,"dark":false,"glyph":false,"overlay":null,"card":{"overline":"ON PUBLIE NOS ERREURS","title":"76 à 79 %\nde fiabilité.","sub":"Selon la saison. Daté, vérifiable. Mesuré, pas deviné."}},{"id":"s8_signature","type":"card","durF":151,"voice":"cache/vo-reel-s8_signature.mp3","img":null,"dark":false,"glyph":true,"overlay":null,"card":{"overline":"LE VEILLEUR","title":"On regarde\nla mer pour vous.","sub":"sargasses-guadeloupe.com"}}],"cues":[{"startF":3,"endF":137,"text":"Hier, au treize heures de T-F-1 : les sargasses atteignent des records en Guadeloupe."},{"startF":156,"endF":324,"text":"Une touriste résume tout : chaque jour, elle regarde quelle plage est chargée, et adapte son programme."},{"startF":342,"endF":418,"text":"La seule différence : elle devine."},{"startF":417,"endF":487,"text":"Nous, on mesure — au satellite."},{"startF":507,"endF":627,"text":"Ramasser à la pelle mécanique, c'est emporter le sable avec les algues."},{"startF":626,"endF":737,"text":"Comme le dit le ramasseur lui-même : on détruit la plage pour la nettoyer."},{"startF":757,"endF":852,"text":"Le Veilleur, lui, ne touche jamais la plage."},{"startF":851,"endF":905,"text":"Il regarde la mer."},{"startF":925,"endF":1021,"text":"Chaque matin, plage par plage : propre ou pas."},{"startF":1019,"endF":1091,"text":"Aujourd'hui, et sept jours devant."},{"startF":1111,"endF":1264,"text":"Et on publie nos erreurs : entre soixante-seize et soixante-dix-neuf pour cent de fiabilité selon la saison."},{"startF":1262,"endF":1340,"text":"Mesuré au satellite, pas deviné."},{"startF":1360,"endF":1420,"text":"On regarde la mer pour vous."},{"startF":1419,"endF":1492,"text":"Sargasses point guadeloupe point com."}]}